cbuffer cbLights : register(b2) { float4 gCamera; float4 gAmbient; float4 gDir; float4 gDirColor; float4 gPointPosRange; float4 gPointColor; float4 gSpotPosRange; float4 gSpotDirPower; float4 gSpotColor; float4x4 gShadowTransform[3]; float4 gCascadeSplits; };
Texture2D<float4> gAlbedoSpec : register(t3); Texture2D<float4> gWorldPos : register(t4); Texture2D<float4> gNormals : register(t5); Texture2DArray<float> gShadowMap : register(t6); SamplerComparisonState gShadowSampler : register(s1);
struct VSOut { float4 Pos:SV_POSITION; };
VSOut VS(uint id:SV_VertexID) { float2 uv=float2((id<<1)&2,id&2); VSOut o; o.Pos=float4(uv*float2(2,-2)+float2(-1,1),0,1); return o; }
float3 Evaluate(float3 N,float3 V,float3 P,float3 L,float3 color,float intensity,float range,float cone) { float d=length(L); float3 l=L/max(d,0.001); float ndl=saturate(dot(N,l)); float att=range>0 ? saturate(1-d/range) : 1; float3 h=normalize(l+V); return color*intensity*att*(ndl+0.15*pow(saturate(dot(N,h)),32)); }
float ShadowFactor(float3 worldPos) { float depth=length(worldPos-gCamera.xyz); uint cascade=depth<gCascadeSplits.x?0:(depth<gCascadeSplits.y?1:2); float4 shadowPos=mul(float4(worldPos,1),gShadowTransform[cascade]); if(any(shadowPos.xy<0)||any(shadowPos.xy>1)||shadowPos.z<=0||shadowPos.z>=1) return 1; float texel=1.0/2048.0; float sum=0; [unroll] for(int y=-1;y<=1;++y) [unroll] for(int x=-1;x<=1;++x) sum+=gShadowMap.SampleCmpLevelZero(gShadowSampler,float3(shadowPos.xy+float2(x,y)*texel,cascade),shadowPos.z-0.0015); return sum/9.0; }
float4 PS(VSOut p):SV_Target { int2 px=int2(p.Pos.xy); float4 a=gAlbedoSpec.Load(int3(px,0)); float3 pos=gWorldPos.Load(int3(px,0)).xyz; float3 n=normalize(gNormals.Load(int3(px,0)).xyz); float3 v=normalize(gCamera.xyz-pos); float3 c=a.rgb*gAmbient.rgb; c+=a.rgb*Evaluate(n,v,pos,-gDir.xyz,gDirColor.rgb,1,0,1)*ShadowFactor(pos); c+=a.rgb*Evaluate(n,v,pos,gPointPosRange.xyz-pos,gPointColor.rgb,gPointColor.a,gPointPosRange.w,1); float3 toSpot=gSpotPosRange.xyz-pos; float cone=pow(saturate(dot(normalize(-toSpot),normalize(gSpotDirPower.xyz))),gSpotDirPower.w); c+=a.rgb*cone*Evaluate(n,v,pos,toSpot,gSpotColor.rgb,gSpotColor.a,gSpotPosRange.w,cone); return float4(pow(saturate(c),1.0/2.2),1); }
