struct VSOut{float4 Pos:SV_POSITION;}; VSOut VS(uint id:SV_VertexID){float2 p=float2((id<<1)&2,id&2);VSOut o;o.Pos=float4(p*float2(2,-2)+float2(-1,1),0,1);return o;}
