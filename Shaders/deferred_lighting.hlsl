float Shadow(float3 p){float d=length(p-gCamera.xyz);uint c=d<gCascadeSplits.x?0:(d<gCascadeSplits.y?1:2);float4 q=mul(float4(p,1),gShadowTransform[c]);if(any(q.xy<0)||any(q.xy>1)||q.z<=0||q.z>=1)return 1;float s=0,t=1.0/2048;[unroll]for(int y=-1;y<=1;y++)[unroll]for(int x=-1;x<=1;x++)s+=gShadowMap.SampleCmpLevelZero(gShadowSampler,float3(q.xy+float2(x,y)*t,c),q.z-.0015);return s/9;}
